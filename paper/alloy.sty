% alloy.sty
% Alloy mode for the LaTeX listings package.


\usepackage{listings}
\usepackage{xcolor}

\makeatletter
\newcommand*{\bnfeq}{%
  \mathrel{\rlap{%
      \raisebox{0.3ex}{$\m@th\cdot$}}%
    \raisebox{-0.3ex}{$\m@th\cdot$}}%
  \mathrel{\rlap{%
      \raisebox{0.3ex}{$\m@th\cdot$}}%
    \raisebox{-0.3ex}{$\m@th\cdot$}}%
  =}
\makeatother

\newcommand\monoellipsis{\hbox to.6em{\hss.\hss\hss.\hss\hss.\hss}}


\lstdefinelanguage{alloy}{
  keywords={%
      assert, pred, all, no, lone, one, some, check, run, for, enum,
      but, let, implies, not, iff, in, and, or, set, sig, Int, int, this,
      if, then, else, exactly, disj, fact, fun, module, abstract,
      extends, open, none, univ, iden, seq, sum, instance, atom, plus, minus, String, expect,
      var, always, eventually, after, until, releases, as,
      historically, before, once, since, triggered, steps
  },
  literate=%
    %% {:}{$\colon$}1
    %% {|}{$\bullet$}1
    %% {==}{$=$}1
    %% {=}{$=$}1
    %% {!=}{$\neq$}1
    %% {&&}{$\land$}1
    %% {||}{$\lor$}1
    %% {<=}{$\le$}1
    %% {>=}{$\ge$}1
    %% {all}{$\forall$}1
    {exists}{\bfseries some}4
    %% {!in}{$\not\in$}1
    %% {\\in}{$\in$}1
    %% {=>}{$\implies$}2
    %% {iff}{$\Longleftrightarrow$}3
    %% % the following isn't actually Alloy, but it gives the option to produce nicer latex
    %% {|=>}{$\Rightarrow$}2
    %% {<=set}{$\subseteq$}1
    %% {+set}{$\cup$}1
    %% {*set}{$\cap$}1
    %% {==>}{$\Longrightarrow$}3 
    %% {<==>}{$\Longleftrightarrow$}4 
    {::=}{$\bnfeq$}1
    {->}{$\to$}1
    {...}{$\monoellipsis$}1
    {~}{$\mathtt{\sim}$}1
    {\\mathp}{$\mathcal{P}$}1
    {\\vdots}{$\vdots$}1
    {\\cdots}{$\cdots$}2
    {\\hl}{$\hline$}1
    {\\alpha}{$\alpha$}1
    {\\beta}{$\beta$}1
    {\\gamma}{$\gamma$}1
    {\\delta}{$\delta$}1
    {\\epsilon}{$\epsilon$}1
    {\\Time}{Time}1
    {\\zeta}{$\zeta$}1
    {\\eta}{$\eta$}1
    {\\theta}{$\theta$}1
    {\\iota}{$\iota$}1
    {\\kappa}{$\kappa$}1
    {\\lambda}{$\lambda$}1
    {\\mu}{$\mu$}1
    {\\nu}{$\nu$}1
    {\\xi}{$\xi$}1
    {\\pi}{$\pi$}1
    {\\rho}{$\rho$}1
    {\\sigma}{$\sigma$}1
    {\\tau}{$\tau$}1
    {\\upsilon}{$\upsilon$}1
    {\\phi}{$\phi$}1
    {\\varphi}{$\varphi$}1
    {\\chi}{$\chi$}1
    {\\psi}{$\psi$}1
    {\\omega}{$\omega$}1
    {\\Gamma}{$\Gamma$}1
    {\\Delta}{$\Delta$}1
    {\\Theta}{$\Theta$}1
    {\\Lambda}{$\Lambda$}1
    {\\square}{$\approx$}1
    {\\Xi}{$\Xi$}1
    {\\Pi}{$\Pi$}1
    {\\Sigma}{$\Sigma$}1
    {\\Upsilon}{$\Upsilon$}1
    {\\Phi}{$\Phi$}1
    {\\llbracket}{$\llbracket$}1
    {\\rrbracket}{$\rrbracket$}1
    {/->}{$\mapsto$}1
    {\\null}{$\varepsilon$}1
    {\\Psi}{$\Psi$}1
    {\\Omega}{$\Omega$}1
    {\\vvv}{}1
    {\\EOF}{\;}1
    {\\+}{${}^{+}$}1
    {\\*}{${}^{*}$}1
    {\\S}{\S}1
    ,
  sensitive=true,  % case sensitive
  morecomment=[l]//,%
  morecomment=[l]{--},%
  morecomment=[s]{/*}{*/},%
  morestring=[b]",
  numbers=left,
  firstnumber=1,
  numbersep=5pt,
  numberstyle=\tiny,
  stepnumber=1,
  basicstyle=\small\ttfamily,
  commentstyle=\color{gray}\itshape,
  keywordstyle=\bfseries,
  ndkeywordstyle=\bfseries,
  columns=flexible,
%  xleftmargin=6pt,
  keepspaces=true,
  moredelim=**[is][\textup]{<<}{>>},
  moredelim=[is][\normalfont]{?}{?},
  moredelim=**[is][\color{red}]{§}{§}
}
\lstnewenvironment{alloyLines}[1][]{%
  \lstset{language=alloy,
    floatplacement={tbp},captionpos=b,
    frame=lines,xleftmargin=18pt,xrightmargin=8pt,basicstyle=\small\ttfamily,#1}}{}
\lstnewenvironment{alloy}[1][]{%
  \lstset{language=alloy,numbers=none,
    floatplacement={tbp},captionpos=b,
    xleftmargin=8pt,xrightmargin=8pt,basicstyle=\small\ttfamily,#1}}{}
 \lstnewenvironment{alloyfig}[1][]{%
   \lstset{belowskip=0pt, language=alloy,
     floatplacement={tbp},captionpos=b,
     xleftmargin=12pt,xrightmargin=0pt,basicstyle=\small\footnotesize,#1}}{}
\def\a{%
    \lstinline[language=alloy,basicstyle=\small\ttfamily,columns=flexible]}
\def\sa{%
    \lstinline[language=alloy,basicstyle=\small\ttfamily,columns=flexible]}
\def\ia{%
    \lstinline[language=alloy,basicstyle=\small\ttfamily,columns=flexible,identifierstyle=\slshape]}
\newcommand{\lstfile}[1]{
  \lstinputlisting[language=alloy,%
    frame=lines,xleftmargin=8pt,xrightmargin=8pt,%
    basicstyle=\small\ttfamily,columns=flexible]{#1}
}
\def\am{%
    \lstinline[language=alloy,basicstyle=\small\ttfamily,columns=flexible,mathescape,identifierstyle=\itshape]}
\newcommand{\ma}[1]{{\textrm{{\sa{#1}}}}}

